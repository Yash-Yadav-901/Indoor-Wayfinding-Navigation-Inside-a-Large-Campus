              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "edges", "2", "congestion"]
            }
          }
        },
        {
          "name": "Toggle Edge Accessibility (Lift Maintenance)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"is_accessible\": false,\n  \"accessibility_reason\": \"Elevator undergoing monthly inspection\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/admin/edges/10/accessibility",
              "host": ["{{baseUrl}}"],
              "path": ["api", "admin", "edges", "10", "accessibility"]
            }
          }
        }
      ]
